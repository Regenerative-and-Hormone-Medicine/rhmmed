---
export const prerender = true;
// Booking calendar: GoHighLevel/Cogitare widget, embedded exactly as on the live site.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Scheduling">
  <section class="mx-auto flex max-w-[125rem] flex-col gap-[3.125rem]">
    <div class="container-site flex items-end justify-between gap-8 pt-28 max-lg:flex-col max-lg:items-start max-md:gap-4 max-sm:pt-32">
      <div class="w-full">
        <iframe
          src="https://go.cogitare.vip/widget/booking/mkGc3OxkFOLw6issadzM"
          style="width: 100%; border: none; overflow: hidden;"
          scrolling="no"
          id="mkGc3OxkFOLw6issadzM_1774369158001"
          title="Book a VIP call"
          class="inline align-baseline"
        ></iframe>
        <br />
        <script is:inline src="https://go.cogitare.vip/js/form_embed.js" type="text/javascript"></script>
      </div>
    </div>
  </section>
</Layout>
