---
// Homepage. Content: the Sanity `page` document for "/" (id page-home), rendered by the page builder like every section page.
import { page as loadPage } from '../lib/content';
import SectionPage from '../layouts/SectionPage.astro';

// Static build: from the `pages` collection. Preview build (SSR): fetched per request, drafts included.
const page = (await loadPage(Astro, '/'))?.data;
if (!page) return new Response(null, { status: 404 });
---

<SectionPage page={page} />
