---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Accordion from '../components/Accordion.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TelehealthCta from '../components/sections/TelehealthCta.astro';
import Reviews from '../components/sections/Reviews.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import Carousel from '../components/sections/Carousel.astro';
import Energy from '../icons/energy.svg';
import Balance from '../icons/balance.svg';
import Clarity from '../icons/clarity.svg';
import Confidence from '../icons/confidence.svg';
import Longevity from '../icons/longevity.svg';
import ArrowSm from '../icons/arrow-sm.svg';

const rotating = ['low energy', 'brain fog', 'poor sleep', 'no motivation', 'fatigue', 'weight gain', 'muscle loss', 'low sex drive', 'depression', 'anxiety', 'moodiness', 'hot flashes'];

const benefits = [
  { icon: Energy, label: 'Energy' },
  { icon: Balance, label: 'Hormone Balance', narrow: true },
  { icon: Clarity, label: 'Clarity' },
  { icon: Confidence, label: 'Confidence' },
  { icon: Longevity, label: 'Longevity' },
];

const paths = [
  {
    href: '/women',
    heading: 'Restore balance through every stage of life',
    link: 'I’m a woman',
    image: '/images/site/69c3bd3ea2d2aeab177f9f6c_da82ea9118ebbf326e7046e6228d5f85_Restore-Balance.avif',
    alt: 'Woman feeling energized outdoors, representing women’s hormone balance and wellness care',
    tint: 'bg-brown',
  },
  {
    href: '/men',
    heading: 'Optimize energy, performance, and health',
    link: 'I’m a man',
    image: '/images/site/69c3bd3e3bec8031638988c5_6273b1ed27c36e60e764182d9f6d8fb3_Optimize-Energy.avif',
    alt: 'Man feeling energized outdoors, representing men’s hormone health, energy, and wellness care',
    tint: 'bg-slate',
    offset: true,
  },
];

const why = [
  { q: 'Energy & Fatigue', a: 'Feeling drained, low on energy, or struggling to get through the day.' },
  { q: 'Mood & Mental Clarity', a: 'Brain fog, irritability, forgetfulness, or difficulty staying focused.' },
  { q: 'Sleep & Recovery', a: 'Trouble falling asleep, staying asleep, or waking up unrested.' },
  { q: 'Weight & Metabolism', a: 'Unexpected weight changes or difficulty maintaining a healthy weight.' },
  { q: 'Performance & Drive', a: 'Low motivation, decreased libido, reduced stamina, or feeling less driven than before.' },
  { q: 'Hormone Balance', a: 'When estrogen, testosterone, thyroid, and/or other hormones are not optimized you just don’t feel like yourself.' },
];

// Webflow's manual sort order for the Solutions collection (not present in the CSV export).
const SOLUTIONS_ORDER = ['long-term-hormonal-support-5', 'supporting-body-function-4', 'energy-improvement-3', 'hormone-balance-2', 'personalized-hormone-care-1'];
const solutions = (await getCollection('solutions')).sort((a, b) => SOLUTIONS_ORDER.indexOf(a.id) - SOLUTIONS_ORDER.indexOf(b.id));

// Hand-built in Webflow (static images, not CMS-bound); kept identical.
const insights = [
  {
    href: '/articles/best-birth-control-for-pcos',
    title: 'Best Birth Control for PCOS — and the Treatment Options Beyond It',
    summary: "The pill isn't the only path with PCOS. A physician-led comparison of birth control options and what else actually helps — beyond the prescription pad.",
    category: 'PCOS',
    date: 'Jul 15, 2026',
    image: '/images/site/6abe41e0a85b393fd9f56249_card-best-birth-control-for-pcos-32.webp',
  },
  {
    href: '/articles/peptides-vs-glp-1',
    title: 'Peptides vs GLP-1: Which One Actually Fits Your Goals?',
    summary: 'Peptides vs GLP-1: which one actually fits your goals — appetite, muscle, or metabolism? A physician-led comparison, not a sales pitch.',
    category: 'Peptides',
    date: 'Jul 30, 2026',
    image: '/images/site/6abe41e0fcb1e77cb74989d8_card-peptides-vs-glp-1-32.webp',
  },
  {
    href: '/articles/pcos-belly-fat',
    title: 'PCOS Belly Fat',
    summary: "PCOS belly fat isn't the same as everyday weight gain. Here's what actually drives it — and a physician-led way to find out what's driving yours.",
    category: 'PCOS',
    date: 'Sep 11, 2026',
    image: '/images/site/6abe40c533fecde0b43c806d_card-pcos-belly-fat-32.webp',
  },
];
---

<Layout
  title="Regenerative & Hormone Medicine | Feel Like Yourself"
  description="Regenerative & Hormone Medicine helps uncover what’s driving low energy, poor sleep, weight, mood, and hormone changes. Book a VIP call."
>
  <!-- Hero -->
  <section class="mx-auto flex max-w-[125rem] flex-col gap-[3.125rem]">
    <div class="container-site flex items-end justify-between gap-8 pt-28 max-lg:flex-col max-lg:items-start max-md:gap-4 max-sm:pt-32">
      <div class="flex w-full max-w-[48rem] flex-col gap-6">
        <h1 class="rotation-heading text-h1 flex flex-wrap items-center gap-x-[10px] text-ink">
          <span>If you experience</span>
          <span class="rotator relative inline-block h-[1.2em] overflow-hidden align-top" aria-hidden="true">
            <span class="rotator-track flex flex-col will-change-transform">
              {rotating.map((w) => <span class="flex h-[1.2em] items-center whitespace-nowrap text-slate">{w}</span>)}
            </span>
          </span>
          <span class="sr-only">{rotating.join(', ')}</span>
          <span>there may be a deeper reason</span>
        </h1>
      </div>
    </div>
    <div class="relative flex flex-col items-center overflow-hidden max-lg:px-6 max-md:flex-col-reverse max-md:gap-8 max-[450px]:px-0">
      <div class="aspect-[2/1] w-full overflow-hidden max-lg:rounded-2xl max-[450px]:rounded-none">
        <video aria-hidden="true" class="size-full object-cover" autoplay loop muted playsinline poster="/images/site/6a50d131c2c6a7c912b6618d_RHM_Hero_720p_compressed_poster.0000000.jpg">
          <source src="/images/site/6a50d131c2c6a7c912b6618d_RHM_Hero_720p_compressed_mp4.mp4" type="video/mp4" />
          <source src="/images/site/6a50d131c2c6a7c912b6618d_RHM_Hero_720p_compressed_webm.webm" type="video/webm" />
        </video>
      </div>
      <div class="container-site absolute z-[1] max-md:relative max-md:flex max-md:flex-col max-md:pl-0 max-sm:pr-0">
        <div class="pt-16 text-white max-lg:pt-8 max-md:pt-0 max-md:text-black max-sm:w-full max-sm:px-4">
          <p class="text-body-l max-w-[34ch]">RHM's licensed medical providers look beyond numbers to uncover the root issues and provide you with personalized treatments.</p>
        </div>
      </div>
      <div class="pointer-events-none absolute top-0 h-full w-full bg-gradient-to-b from-black/60 to-transparent max-lg:w-[calc(100%-3rem)] max-lg:rounded-2xl max-md:hidden max-[450px]:w-[calc(100%-2rem)]"></div>
    </div>
  </section>

  <!-- Designed -->
  <section class="bg-bg-light">
    <div class="mx-auto flex w-full max-w-[66.25rem] flex-col items-center gap-20 px-8 py-[7.5rem] text-center max-md:px-6 max-md:py-20 max-sm:gap-8 max-sm:px-4">
      <div class="flex max-w-[46rem] flex-col items-center gap-6 max-sm:text-left">
        <h2>Regenerative care designed <br />to restore hormone balance now and support long-term health</h2>
        <p class="text-body-l text-ink-70">When changes in energy, mood, sleep, or other symptoms occur there’s usually a deeper reason. RHM's medical providers partner with you to uncover the cause and help you feel like yourself again.</p>
      </div>
      <ul class="flex flex-wrap items-start justify-center gap-20 max-lg:w-full max-lg:gap-[2.9rem] max-md:gap-8 max-sm:gap-x-[2.2rem] max-sm:gap-y-8">
        {benefits.map(({ icon: Icon, label, narrow }) => (
          <li class="flex flex-col items-center gap-4 max-sm:min-w-[82px]">
            <Icon class="aspect-square w-8 text-ink" width="32" height="32" />
            <p class:list={['text-body-l', narrow ? 'max-lg:max-w-[10ch]' : 'max-w-[34ch]']}>{label}</p>
          </li>
        ))}
      </ul>
      <div class="flex w-full items-start justify-center gap-8 max-md:flex-col">
        {paths.map((p) => (
          <a
            href={p.href}
            class:list={[
              'path-card group relative flex aspect-[243/280] w-full max-w-[30.375rem] flex-col items-start justify-end overflow-hidden rounded-[24px] p-9 text-left text-white transition-all duration-400 hover:rounded-[300px]',
              p.offset && 'mt-[6.25rem] max-md:mt-0',
            ]}
          >
            <img src={p.image} alt={p.alt} class="absolute inset-x-0 bottom-0 z-0 w-full object-cover transition-transform duration-400 group-hover:scale-120 max-md:object-[50%_100%]" loading="lazy" />
            <div class="absolute inset-0 z-[1] bg-gradient-to-b from-transparent to-black/80"></div>
            <div class="absolute inset-0 z-[1] flex w-full flex-col items-start justify-end gap-6 p-8 transition-transform duration-350 group-hover:-translate-y-[33%]">
              <h3 class="text-h3 text-white">{p.heading}</h3>
              <div class="flex items-center justify-center gap-2 text-[.875rem] leading-[1.214] uppercase">
                <div>{p.link}</div>
                <ArrowSm class="size-3" width="12" height="12" />
              </div>
            </div>
            <div class:list={['absolute inset-0 opacity-0 mix-blend-multiply transition-opacity duration-400 group-hover:opacity-100', p.tint]}></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why people work with us -->
  <section>
    <div class="container-site flex items-start justify-between gap-8 border-b border-bg-light pt-[7.5rem] pb-[8.75rem] max-md:flex-col max-md:py-20">
      <div class="flex w-full max-w-[48rem] flex-col gap-6">
        <h2>Why people work with us</h2>
        <div class="flex flex-col gap-[3.125rem]">
          <p class="text-body-l text-ink-70">When patients understand that medicine is not one-size-fits-all, they partner with us to find answers no one else has been able to explain.</p>
          <div class="flex items-center gap-2.5 max-sm:flex-col max-sm:items-start">
            <Button href="/scheduling">Book vip call</Button>
          </div>
        </div>
      </div>
      <Accordion items={why} class="max-w-[37.125rem]" />
    </div>
  </section>

  <Carousel
    heading="Personalized physician-led medical care focused on root causes, not quick fixes"
    body="Bioidentical Hormone Replacement Therapy    <br />Testosterone Replacement Therapy  <br /> Comprehensive Lab Testing  <br />Peptide Therapy • Weight Loss Management • Supplements "
    slides={solutions.map((x) => ({ title: x.data.name, body: x.data.paragraph, image: x.data.image }))}
  />

  <TelehealthCta />

  <Reviews />

  <!-- Research & Insights -->
  <section class="bg-bg-light">
    <div class="container-site flex flex-col gap-[3.125rem] py-[7.5rem]">
      <div class="flex items-end justify-between gap-8 max-md:flex-col max-md:items-start max-md:gap-4">
        <h2 class="w-full max-w-[31.5rem]">Research &amp; Insights</h2>
        <Button href="/articles">View articles</Button>
      </div>
      <div class="grid grid-cols-3 gap-4 max-md:grid-cols-1">
        {insights.map((a) => <ArticleCard {...a} white />)}
      </div>
    </div>
  </section>

  <FinalCta />
</Layout>

<style>
  @media (max-width: 767px) {
    .rotation-heading { width: 100%; font-size: 2.5rem; letter-spacing: -0.04rem; }
  }
</style>

<script>
  // Rotating hero word (source: 600ms slide, 2s hold, starts after 1s, seamless loop via a clone).
  const track = document.querySelector<HTMLElement>('.rotator-track');
  if (track && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const SLIDE = 600, HOLD = 2000;
    track.appendChild(track.firstElementChild!.cloneNode(true));
    const real = track.children.length - 1;
    let i = 0;
    const go = (n: number, animate = true) => {
      track.style.transition = animate ? `transform ${SLIDE}ms ease` : 'none';
      track.style.transform = `translateY(-${n * (track.firstElementChild as HTMLElement).offsetHeight}px)`;
    };
    const next = () => {
      i++;
      go(i);
      if (i === real) setTimeout(() => { i = 0; go(0, false); void track.offsetHeight; setTimeout(next, HOLD); }, SLIDE);
      else setTimeout(next, SLIDE + HOLD);
    };
    setTimeout(() => setTimeout(next, HOLD), 1000);
  }

</script>
