---
// Single-segment page-builder pages: hubs (/men, /women), info pages, /contact, /scheduling. Content: Sanity `page` documents.
// The homepage ("/") is src/pages/index.astro.
import { getCollection } from 'astro:content';
import { page as loadPage } from '../lib/content';
import SectionPage from '../layouts/SectionPage.astro';

export async function getStaticPaths() {
  const pages = (await getCollection('pages')).filter((e) => e.id !== '/' && e.id.split('/').length === 2);
  return pages.map((e) => ({ params: { page: e.id.slice(1) }, props: { page: e.data } }));
}

// Static build: from getStaticPaths. Preview build (SSR): fetched per request, drafts included.
const page = Astro.props.page ?? (await loadPage(Astro, `/${Astro.params.page}`))?.data;
if (!page) return new Response(null, { status: 404 });
---

<SectionPage page={page} />
