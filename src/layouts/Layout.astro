---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Tracking from '../components/Tracking.astro';

interface Props {
  title: string;
  description?: string;
  /** 'light' for pages whose hero is a dark image (white header text until scrolled). */
  headerTheme?: 'dark' | 'light';
  /** Set false for pages without the site chrome (e.g. /style-guide). */
  chrome?: boolean;
  ogImage?: string;
  ogType?: string;
  footer?: { minimal?: boolean; blurb?: string } | null;
  /** noindex,follow — the live site sets this on /privacy-policy and /terms-of-use. Also keeps the page out of sitemap.xml. */
  noindex?: boolean;
  /** Page-level JSON-LD objects (copied from the live page, or generated from the CMS for articles). */
  schema?: object[];
}

const { title, description, headerTheme = 'dark', chrome = true, ogImage, ogType = 'website', footer, noindex = false, schema = [] } = Astro.props;
const SITE = 'https://www.rhmmed.com';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const canonical = path ? SITE + path : SITE;
// Site-wide Organization (new: the live site has none). Facts only from the site itself: name, logo, social profiles.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Regenerative & Hormone Medicine',
  alternateName: 'RHM',
  url: SITE,
  logo: `${SITE}/images/site/69f20289e8439a43c8e446ff_rsm-logo-logo-grey-01-png.png`,
  sameAs: ['https://www.facebook.com/RSMedicine01', 'https://www.instagram.com/regenerativeandhormonemedicine/'],
};
const jsonld = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta property="og:type" content={ogType} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, 'https://www.rhmmed.com').href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="google-site-verification" content="ri7Lby20xPl667ZCCyisSddlvqHr7EZ4EB5PSlt6xlo" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    {chrome && <script type="application/ld+json" set:html={jsonld(organization)} />}
    {schema.map((o) => <script type="application/ld+json" set:html={jsonld(o)} />)}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-dark.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-light.png" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/GeistVF.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <Tracking />
    <script is:inline>
      // Remember the previous page for form submissions (live site: last_page in sessionStorage).
      try { var c = location.href, p = sessionStorage.getItem('current_page'); if (p && p !== c) sessionStorage.setItem('last_page', p); sessionStorage.setItem('current_page', c); } catch (e) {}
    </script>
  </head>
  <body>
    {chrome && <Header theme={headerTheme} />}
    <main>
      <slot />
    </main>
    {chrome && <Footer minimal={footer?.minimal} blurb={footer?.blurb} />}
  </body>
</html>
