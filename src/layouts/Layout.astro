---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Tracking from '../components/Tracking.astro';
import liveHead from '../data/live-head.json';
import VisualEditing from 'rhm:visual-editing';
import { isPreview } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  /** 'light' for pages whose hero is a dark image (white header text until scrolled). */
  headerTheme?: 'dark' | 'light';
  /** Set false for pages without the site chrome (e.g. /style-guide). */
  chrome?: boolean;
  ogImage?: string;
  ogType?: string;
  footer?: { minimal?: boolean; blurb?: string } | null;
}

const { title, description, headerTheme = 'dark', chrome = true, ogImage, ogType = 'website', footer } = Astro.props;
// Share image (Evgenii, 2026-11-27, "B"): LinkedIn, Facebook and Slack don't show AVIF, so Sanity images are served as a
// 1200×630 JPG crop by the image CDN. Site paths (old data, the homepage video poster) are used as they are.
const shareImage = (src: string) => {
  const url = new URL(src, 'https://www.rhmmed.com');
  if (url.hostname === 'cdn.sanity.io') url.search = 'w=1200&h=630&fit=crop&fm=jpg';
  return url.href;
};
const SITE = 'https://www.rhmmed.com';
// File output (dist/men.html): strip .html/index so the canonical stays https://www.rhmmed.com/men, as on live.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '').replace(/\/$/, '');
const canonical = path ? SITE + path : SITE;
// Head JSON-LD and robots meta copied verbatim from live (scripts/fetch-live-head.mjs; Evgenii, 2026-11-24: live is the
// source of truth for now). Pages not on live (404, /style-guide) keep the default robots meta.
const live = (liveHead as Record<string, { robots: string | null; jsonld: string[] }>)[path || '/'];
// The editorial preview (rhmmed-preview.vercel.app) must never be indexed.
const robots = isPreview ? 'noindex, nofollow' : live ? live.robots : 'index, follow';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta property="og:type" content={ogType} />
    {ogImage && <meta property="og:image" content={shareImage(ogImage)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="google-site-verification" content="ri7Lby20xPl667ZCCyisSddlvqHr7EZ4EB5PSlt6xlo" />
    {path !== "/404" && <link rel="canonical" href={canonical} />}
    {robots && <meta name="robots" content={robots} />}
    {live?.jsonld.map((j) => <script type="application/ld+json" set:html={j} />)}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-dark.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-light.png" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/GeistVF.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    {!isPreview && <Tracking />}
    <script is:inline>
      // Remember the previous page for form submissions (live site: last_page in sessionStorage).
      try { var c = location.href, p = sessionStorage.getItem('current_page'); if (p && p !== c) sessionStorage.setItem('last_page', p); sessionStorage.setItem('current_page', c); } catch (e) {}
    </script>
  </head>
  <body>
    {chrome && <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded-pill focus:bg-black focus:px-[22px] focus:py-3 focus:text-btn focus:text-white">Skip to content</a>}
    {chrome && <Header theme={headerTheme} />}
    <main id="main" class="overflow-x-clip"><!-- source: .page-wrapper { overflow-x: clip } — no sideways scroll on phones -->
      <slot />
    </main>
    <script is:inline>
      // Reduced motion: stop background videos on the poster frame (WCAG 2.2.2). Others see no change.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll('video[autoplay]').forEach(function (v) { v.removeAttribute('autoplay'); v.pause(); });
    </script>
    {chrome && <Footer minimal={footer?.minimal} blurb={footer?.blurb} />}
    {isPreview && <VisualEditing />}
  </body>
</html>
