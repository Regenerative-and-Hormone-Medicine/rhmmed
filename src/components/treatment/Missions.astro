---
// Long-form statement with an image strip (source: .container.is-missions).
import type { Img } from './types';
type Block = { kind: 'h1' | 'body'; html: string } | { kind: 'images'; two: boolean; images: Img[] };
interface Props { compact: boolean; label: string; blocks: Block[] }
const p = Astro.props;
const heights = ['h-[80%]', 'h-[90%]', 'h-full'];
// Small screens: the default variant fills the row at ≤767; the compact ("smaller") variant keeps 80%/90% there
// and fills only at ≤479 (measured on the live page).
const mobile = (two: boolean) => (two || p.compact ? 'max-sm:h-full' : 'max-md:h-full');
---

<section>
  <div class:list={['container-site flex flex-col gap-[6.25rem] max-md:gap-16 max-md:py-20', p.compact ? 'pt-[3.75rem] pb-[8.75rem]' : 'pt-[12.5rem] pb-[13.75rem]']}>
    <h2 class="text-h4" set:html={p.label} />
    <div class="flex flex-col gap-[3.125rem]">
      {p.blocks.map((b) =>
        b.kind === 'images' ? (
          <div class:list={['grid min-h-[30.1875rem] w-full items-end gap-6', b.two ? 'grid-cols-2 max-sm:grid-cols-[auto]' : 'grid-cols-3 max-md:grid-cols-1']}>
            {b.images.map((im, i) => im && (
              <div class:list={['w-full overflow-hidden rounded-2xl', heights[i] ?? 'h-full', mobile(b.two)]}>
                <img src={im.src} alt={im.alt} class="size-full object-cover" loading="lazy" />
              </div>
            ))}
          </div>
        ) : (
          <div class:list={['rich', b.kind === 'h1' ? 'text-h1 text-ink' : 'text-body-l']} set:html={b.html} />
        ),
      )}
    </div>
  </div>
</section>
