---
// "What is X?" coloured band (source: .section.is-causes_white.is-brown).
interface Props { slate: boolean; label: string; blocks: { tag: string; cls: string; html: string }[] }
const p = Astro.props;
---

<section class:list={['py-32 text-white max-md:py-16', p.slate ? 'bg-slate' : 'bg-brown']}>
  <div class="container-site flex flex-col gap-16">
    <h2 class="text-h4 text-white/60" set:html={p.label} />
    <div class="flex flex-col gap-20 max-md:gap-12">
      {p.blocks.map((b) => {
        const Tag = (b.tag === 'h3' ? 'h3' : b.tag === 'p' ? 'p' : 'div') as 'h3' | 'p' | 'div';
        return <Tag class:list={['rich text-white', b.cls === 'h1' ? 'text-h1' : 'text-body-l']} set:html={b.html} />;
      })}
    </div>
  </div>
</section>
