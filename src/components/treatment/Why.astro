---
import { imgAttrs } from '../../lib/portable-text.mjs';
import Rich from '../Rich.astro';
// "Why RHM" physician photo + stats (source: .section.is-why).
import type { Img } from './types';
interface Props { spacers?: string[]; image: Img; label: string; heading: string; body: string; stats: { value: string; label: string }[] }
const p = Astro.props;
const sp = { xl: 'h-[12.5rem] max-md:h-24 max-sm:h-16', md: 'h-20 max-md:h-16', none: 'h-0 max-md:h-16', base: 'h-[7.5rem] max-md:h-16' } as Record<string, string>;
const [top = 'xl', bottom = 'xl'] = p.spacers ?? [];
---

<section>
  <div class={sp[top]}></div>
  <div class="container-site flex items-stretch justify-between gap-6 max-md:flex-col-reverse max-md:gap-12">
    <div class="min-h-[39.6875rem] w-full max-w-[36.875rem] overflow-hidden rounded-2xl max-md:min-h-0">
      {p.image && <img {...imgAttrs(p.image.src, { sizes: '(max-width: 767px) 100vw, 590px' })} alt={p.image.alt} class="size-full object-cover" loading="lazy" />}
    </div>
    <div class="flex w-full max-w-[36.875rem] flex-col gap-[3.125rem]">
      <div class="flex flex-col items-start gap-6">
        <div class="text-label">{p.label}</div>
        <h2 class="text-h2" set:html={p.heading} />
        <Rich class="text-body-m text-ink-70" html={p.body} />
      </div>
      <div class="flex flex-col gap-24 max-sm:gap-12">
        {p.stats.map((s) => (
          <div class="flex items-end justify-between border-b border-bg-dark pb-2.5 max-sm:flex-col max-sm:items-start max-sm:gap-4">
            <p class="text-h1">{s.value}</p>
            <div class="text-body-r text-ink-70">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class={sp[bottom]}></div>
</section>
