---
// Sky-blue CTA with drifting-cloud video (source: .container.is-cta / .cta-abs_img).
import Button from '../Button.astro';

interface Props {
  heading?: string;
  points?: string[];
  /** Source variant "top-padding" (legal pages): white space above the block. */
  topPad?: boolean;
}
const {
  heading = 'Start your journey to personalized, long-term health',
  points = ['Ongoing support focused on long-term health', 'Advanced testing and clear next steps', 'Physician-led care'],
  topPad = false,
} = Astro.props;
---

<section class:list={[topPad && 'pt-20']}>
  <div class="relative min-h-[28rem] overflow-hidden bg-[#c0e5ff] py-20 max-md:py-12 max-sm:px-6 max-sm:py-10">
    <div
      class="absolute inset-x-0 bottom-0 h-[500px] w-full -scale-x-100 overflow-hidden bg-no-repeat mix-blend-lighten"
      style="background-image:url('/images/site/69932c6ce6a70f61027ebdda_2625-161232147-1.avif')"
      aria-hidden="true"
    >
      <video
        class="absolute inset-0 size-full object-cover"
        autoplay
        loop
        muted
        playsinline
        poster="/images/site/69a5738592d3359100043326_psrmed-700_poster.0000000.jpg"
      >
        <source src="/images/site/69a5738592d3359100043326_psrmed-700_mp4.mp4" type="video/mp4" />
        <source src="/images/site/69a5738592d3359100043326_psrmed-700_webm.webm" type="video/webm" />
      </video>
    </div>
    <div class="container-site relative flex justify-between max-lg:flex-col max-lg:gap-10">
      <h2 class="text-h1 w-full max-w-[32.3125rem]">{heading}</h2>
      <div class="flex max-w-[28.5rem] flex-col gap-[3.125rem]">
        <ul class="flex flex-col gap-4">
          {points.map((p) => (
            <li class="check text-body-m">{p}</li>
          ))}
        </ul>
        <div class="flex items-center gap-2.5 max-sm:flex-col max-sm:items-start">
          <Button href="/scheduling">Book VIP Call</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .check {
    padding-left: 2.125rem;
    background: url('/images/site/6989f1f49e95bc8ff3f2bcfd_checkmark.svg') no-repeat 0 0.25rem / 1.125rem 1.125rem;
  }
</style>
