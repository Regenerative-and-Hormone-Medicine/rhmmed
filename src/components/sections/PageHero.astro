---
// Grey intro band: label + h1 left, copy + buttons right (source: .section.is-location-hero).
import Button from '../Button.astro';
interface Props { label: string; heading: string; body: string; buttons: { text: string; href: string }[]; big?: boolean; leftMax?: string | null; rightMax?: string | null }
const p = Astro.props;
---

<section class="bg-bg-light pt-[9.375rem] pb-20 max-md:pt-32 max-md:pb-16 max-sm:pt-28">
  <div class="container-site flex items-end justify-between max-md:flex-col max-md:items-start max-md:gap-8">
    <div class="flex w-full flex-col gap-6" style={`max-width:${p.leftMax ?? '391px'}`}>
      <div class="text-label">{p.label}</div>
      <h1 class:list={[p.big && 'text-[4.625rem] max-md:text-[3rem] max-sm:text-[2.5rem]']} set:html={p.heading} />
    </div>
    <div class="flex w-full flex-col items-start gap-8" style={`max-width:${p.rightMax ?? '423px'}`}>
      {p.body && <p class="text-body-m text-[#050514cc]" set:html={p.body} />}
      {p.buttons.length > 0 && (
        <div class="flex items-center gap-2.5 max-sm:w-full max-sm:flex-col max-sm:items-start">
          {p.buttons.map((b) => <Button href={b.href}>{b.text}</Button>)}
        </div>
      )}
    </div>
  </div>
</section>
