---
// "Before your visit" cards with black icon tiles (source: .section.is-preparation).
import Rich from '../Rich.astro';
import Button from '../Button.astro';
interface Props { heading: string; body: string; cards: { icon: string | null; title: string; body: string; buttons: { text: string; href: string }[] }[] }
const p = Astro.props;
---

<section class="bg-bg-light py-[8.75rem] max-md:py-16">
  <div class="container-site flex flex-col gap-20 max-md:gap-12">
    <div class="flex w-full max-w-[44rem] flex-col items-start gap-8">
      <h2 set:html={p.heading} />
      <Rich class="text-body-l text-ink-70" html={p.body} />
    </div>
    <div class="grid grid-cols-2 gap-4 max-md:grid-cols-1">
      {p.cards.map((c) => (
        <div class="flex flex-col items-start gap-[3.75rem] rounded-3xl bg-white p-8 max-sm:gap-8 max-sm:p-6">
          <div class="prep-icon flex size-[54px] items-center justify-center rounded-xl bg-black text-white" set:html={c.icon ?? ''} />
          <div class="flex w-full flex-col items-start gap-6">
            <h3 class="text-h4 capitalize" set:html={c.title} />
            <Rich class="text-body-m" html={c.body} />
            {c.buttons.map((b) => <Button href={b.href}>{b.text}</Button>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .prep-icon :global(svg) { width: 28px; color: #fff; }
</style>
