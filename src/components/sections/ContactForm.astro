---
// /contact: label + h1 beside a white card with the contact form (Formspark "Contact" form + Botpoison, same endpoint and
// payload as the live site; src/lib/formspark.ts). Field names, types and validation are fixed here; the block holds the copy.
// The <style> is is:inline: rules only this page needs, kept out of the CSS bundle every builder page shares.
interface Props {
  label: string; heading: string; formHeading: string;
  /** Name, email, phone, message, in that order. */
  fields: { label: string; placeholder: string }[];
  submit: string; done: string; fail: string;
}
const p = Astro.props;
const [name, email, phone, message] = p.fields;
---

<section class="bg-bg-light pt-[9.375rem] pb-20 max-sm:pt-28">
  <div class="container-site grid grid-cols-2 items-start gap-4 max-lg:grid-cols-1 max-lg:gap-12 max-md:gap-8">
    <div class="flex w-full max-w-[487px] flex-col gap-6">
      <div class="text-label">{p.label}</div>
      <h1>{p.heading}</h1>
    </div>
    <div class="flex flex-col gap-8 rounded-3xl bg-white p-8 max-sm:p-5">
      <h2 class="text-[1.75rem] leading-[1.3] normal-case max-md:text-[1.5rem]">{p.formHeading}</h2>
      <div class="mb-[15px]">
        <form id="contact-form" class="flex flex-col gap-4" novalidate>
          <div class="flex flex-col">
            <label for="name" class="text-label mb-1">{name.label}</label>
            <input class="field" maxlength="256" name="name" placeholder={name.placeholder} type="text" id="name" autocomplete="name" required />
          </div>
          <div class="flex flex-col">
            <label for="Email" class="text-label mb-1">{email.label}</label>
            <input class="field" maxlength="256" name="Email" placeholder={email.placeholder} type="email" id="Email" autocomplete="email" spellcheck="false" required />
          </div>
          <div class="flex flex-col">
            <label for="Phone-Number" class="text-label mb-1">{phone.label}</label>
            <input class="field" maxlength="256" name="Phone-Number" placeholder={phone.placeholder} type="tel" id="Phone-Number" autocomplete="tel" required />
          </div>
          <div class="flex flex-col">
            <label for="Message" class="text-label mb-1">{message.label}</label>
            <textarea class="field h-[8.8125rem] py-4" placeholder={message.placeholder} maxlength="5000" id="Message" name="Message"></textarea>
            <div aria-hidden="true" class="absolute -left-[9999px]">
              <input type="text" name="website" autocomplete="off" tabindex="-1" value="" />
            </div>
          </div>
          <button type="submit" class="self-start rounded-pill bg-black px-[22px] py-3 text-btn text-white disabled:opacity-60" data-wait="Please wait...">{p.submit}</button>
        </form>
        <div id="contact-success" hidden class="p-5 text-left" tabindex="-1">{p.done}</div>
        <div id="contact-fail" role="alert" hidden class="mt-2.5 bg-[#ffdede] p-2.5">{p.fail}</div>
      </div>
    </div>
  </div>
</section>

<style is:inline>
  .field { height: 2.9375rem; border: 1px solid #e3e3e3; border-radius: .5rem; background: #fff; padding: .5rem 1rem; font-size: .875rem; }
  .field::placeholder { font-size: 1rem; line-height: 1.3; color: #999; }
  textarea.field { height: 8.8125rem; padding-top: 1rem; padding-bottom: 1rem; }
</style>

<script>
  import { FORMS, submitToFormspark, splitName, validPhone } from '../../lib/formspark';
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const ok = document.getElementById('contact-success')!;
  const fail = document.getElementById('contact-fail')!;
  const button = form.querySelector('button')!;
  const phone = form.elements.namedItem('Phone-Number') as HTMLInputElement;
  phone.addEventListener('input', () => phone.setCustomValidity(''));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const v = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '').trim();
    if (v('website')) return; // honeypot
    phone.setCustomValidity(validPhone(phone.value) ? '' : 'Please enter a valid phone number.');
    if (!form.checkValidity()) return form.reportValidity();
    button.disabled = true;
    const label = button.textContent;
    button.textContent = button.dataset.wait!;
    fail.hidden = true;
    try {
      await submitToFormspark(FORMS.contact, {
        ...splitName(v('name')), name: v('name'), email: v('Email'), phone: v('Phone-Number'),
        message: v('Message'), website: v('website'), form_name: 'Contact Form',
      });
      form.hidden = true;
      ok.hidden = false;
      ok.focus({ preventScroll: true });
    } catch (err) {
      console.error('[Contact] Submission failed:', err);
      button.disabled = false;
      button.textContent = label;
      fail.hidden = false;
    }
  });
</script>
