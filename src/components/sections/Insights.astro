---
// "Research & Insights" — heading, button, 3 article cards (source: .container.is-inner-resources).
import Button from '../Button.astro';
import ArticleCard from '../ArticleCard.astro';
import { articleCards, type Card } from '../../lib/article-cards';
// `empty`: text of the live CMS list's empty state (Webflow `.w-dyn-empty`: #ddd box, 10px padding). Live keeps that section
// in the HTML but hides it (display:none), so with no cards the section renders hidden.
// `articles`: article ids picked in Sanity (the CMS-driven shape); the cards are built from those articles. `cards`: the
// old copied-card shape, still read for documents that predate it (production before the cutover).
interface Props { heading?: string; button?: { text: string; href: string } | null; cards?: Card[]; articles?: string[]; tone?: 'grey' | 'mist'; empty?: string }
const { heading = 'Research & Insights', button = { text: 'View articles', href: '/articles' }, articles, tone = 'grey', empty } = Astro.props;
const cards = articles ? await articleCards(Astro, articles) : Astro.props.cards ?? [];
---

<section class:list={[tone === 'mist' ? 'bg-mist' : 'bg-bg-light']} hidden={cards.length === 0}>
  <div class="container-site flex flex-col gap-[3.125rem] py-[7.5rem]">
    <div class="flex items-end justify-between gap-8 max-md:flex-col max-md:items-start max-md:gap-4">
      <h2 class="w-full max-w-[31.5rem]">{heading}</h2>
      {button && <Button href={button.href}>{button.text}</Button>}
    </div>
    {cards.length === 0 && empty ? (
      <div class="bg-[#ddd] p-2.5"><div>{empty}</div></div>
    ) : (
      <div class="grid grid-cols-3 gap-4 max-md:grid-cols-1">
        {cards.map((c) => (
          <ArticleCard href={c.href} title={c.title} summary={c.summary} category={c.category} date={c.date} image={c.image?.src ?? ''} alt={c.image?.alt} white />
        ))}
      </div>
    )}
  </div>
</section>
