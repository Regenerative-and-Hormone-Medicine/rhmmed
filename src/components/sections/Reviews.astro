---
// "Real experiences" — heading + Reputation Hub (LeadConnector) reviews widget, lazy-loaded like the source.
interface Props { grey?: boolean; heading?: string; body?: string; bare?: boolean; pad?: string }
const {
  grey = false,
  bare = false,
  pad = 'py-[7.5rem]',
  heading = 'Real experiences from people we’ve helped',
  body = 'Thoughtful, personalized care can make a meaningful difference. Here’s what patients have shared about their experience with Regenerative &amp; Hormone Medicine.',
} = Astro.props;
---

{bare ? (
  <section>
    <div class:list={['container-site', pad]}><div data-reviews class="min-h-[400px]"></div></div>
  </section>
) : (
<section class:list={[grey && 'bg-bg-light']}>
  <div class="container-site flex flex-col gap-[7.5rem] py-[12.5rem] max-md:gap-20 max-md:py-16">
    <div class="flex items-end justify-between gap-8 max-md:flex-col max-md:items-start max-md:gap-4">
      <h2 class="w-full max-w-[31.5rem]" set:html={heading} />
      <p class="text-body-l w-full max-w-[31.25rem] text-ink-70" set:html={body} />
    </div>
    <div>
      <div data-reviews class="min-h-[400px]"></div>
    </div>
  </div>
</section>
)}

<script>
  const SRC = 'https://reputationhub.site/reputation/widgets/review_widget/Nzciuab13XcGRK2k3mkR?widgetId=69c536371fce5b953f6ba053';
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((el) => {
    const load = () => {
      const iframe = document.createElement('iframe');
      iframe.className = 'lc_reviews_widget';
      iframe.src = SRC;
      iframe.title = 'Patient reviews';
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('scrolling', 'no');
      iframe.style.cssText = 'display:inline;vertical-align:baseline;min-width:100%;width:100%;min-height:400px;border:0'; // inline like the source (adds its line-box gap)
      el.appendChild(iframe);
      if (!document.querySelector('script[data-review-widget]')) {
        const s = document.createElement('script');
        s.src = 'https://reputationhub.site/reputation/assets/review-widget.js';
        s.dataset.reviewWidget = '';
        document.body.appendChild(s);
      }
    };
    if (!('IntersectionObserver' in window)) return load();
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { load(); io.disconnect(); }
    }, { rootMargin: '300px' });
    io.observe(el);
  });
</script>
