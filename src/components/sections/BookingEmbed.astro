---
// Booking calendar: GoHighLevel/Cogitare widget, embedded exactly as on the live site (/scheduling).
interface Props { src: string; frameId: string; title: string }
const { src, frameId, title } = Astro.props;
---

<section class="mx-auto flex max-w-[125rem] flex-col gap-[3.125rem]">
  <div class="container-site flex items-end justify-between gap-8 pt-28 max-lg:flex-col max-lg:items-start max-md:gap-4 max-sm:pt-32">
    <div class="w-full">
      <iframe
        src={src}
        style="width: 100%; border: none; overflow: hidden;"
        scrolling="no"
        id={frameId}
        title={title}
        class="inline align-baseline"
      ></iframe>
      <br />
      <script is:inline src="https://go.cogitare.vip/js/form_embed.js" type="text/javascript"></script>
    </div>
  </div>
</section>
